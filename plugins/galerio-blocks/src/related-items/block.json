{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "galerio/related-items",
	"version": "0.1.0",
	"title": "Galerio Related Items",
	"category": "theme",
	"icon": "screenoptions",
	"description": "Retired: use a Query Loop's Related items setting instead, or transform this block into one. Shows the items related to the current one as cards.",
	"keywords": [ "related", "works", "profiles", "collections", "galerio" ],
	"textdomain": "galerio-blocks",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"field": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": "{field}"
		},
		"headingLevel": {
			"type": "number",
			"default": 2
		},
		"layout": {
			"type": "string",
			"enum": [ "grid", "list" ],
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"limit": {
			"type": "number",
			"default": 0
		},
		"order": {
			"type": "string",
			"enum": [ "saved", "title", "random" ],
			"default": "saved"
		},
		"showImage": {
			"type": "boolean",
			"default": true
		},
		"aspectRatio": {
			"type": "string",
			"default": "4/3"
		},
		"detail": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"inserter": false,
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
