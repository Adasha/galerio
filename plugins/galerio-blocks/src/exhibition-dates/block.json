{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "galerio/exhibition-dates",
	"version": "0.1.0",
	"title": "Galerio Exhibition Dates",
	"category": "theme",
	"icon": "calendar-alt",
	"description": "Shows when an exhibition or other collection opens and closes, and whether it's upcoming, on now or past. Hidden when the collection has no dates.",
	"keywords": [ "dates", "exhibition", "opening", "closing", "galerio" ],
	"textdomain": "galerio-blocks",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"format": {
			"type": "string",
			"enum": [ "site", "short" ],
			"default": "site"
		},
		"showStatus": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": true,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
