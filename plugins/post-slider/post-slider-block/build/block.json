{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "post-slider-block/slider",
	"version": "1.0.0",
	"title": "Post Slider",
	"category": "widgets",
	"icon": "slides",
	"description": "Display the latest posts from any post type or taxonomy in a configurable slider with multiple transition effects.",
	"keywords": ["slider", "posts", "carousel", "gallery"],
	"textdomain": "post-slider-block",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": false
	},
	"attributes": {
		"postType": { "type": "string", "default": "post" },
		"numberOfPosts": { "type": "number", "default": 5 },
		"taxonomy": { "type": "string", "default": "" },
		"selectedTerms": { "type": "array", "default": [], "items": { "type": "number" } },
		"orderBy": { "type": "string", "default": "date" },
		"order": { "type": "string", "default": "DESC" },
		"transition": { "type": "string", "default": "fade" },
		"transitionDuration": { "type": "number", "default": 600 },
		"autoplay": { "type": "boolean", "default": false },
		"autoplayInterval": { "type": "number", "default": 5000 },
		"pauseOnHover": { "type": "boolean", "default": true },
		"showNavigation": { "type": "boolean", "default": true },
		"showDots": { "type": "boolean", "default": true },
		"showFeaturedImage": { "type": "boolean", "default": true },
		"imageSize": { "type": "string", "default": "large" },
		"overlayOpacity": { "type": "number", "default": 0.4 },
		"overlayColor": { "type": "string", "default": "#000000" },
		"showExcerpt": { "type": "boolean", "default": true },
		"excerptLength": { "type": "number", "default": 20 },
		"showMeta": { "type": "boolean", "default": true },
		"showAuthor": { "type": "boolean", "default": false },
		"showTerms": { "type": "boolean", "default": true },
		"showReadMore": { "type": "boolean", "default": true },
		"readMoreText": { "type": "string", "default": "Read More" },
		"linkTitle": { "type": "boolean", "default": true },
		"headingTag": { "type": "string", "default": "h3" },
		"contentPosition": { "type": "string", "default": "left" },
		"accentColor": { "type": "string", "default": "#3b82f6" },
		"textColor": { "type": "string", "default": "#ffffff" },
		"backgroundColor": { "type": "string", "default": "#1e293b" },
		"slideHeight": { "type": "number", "default": 520 },
		"borderRadius": { "type": "number", "default": 12 }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
