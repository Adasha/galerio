{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "galerio/enquiry",
	"version": "0.1.0",
	"title": "Galerio Enquiry",
	"category": "theme",
	"icon": "email-alt",
	"description": "A form for asking about the current work, sent by email. Shown only while the catalogue is on and the work is available or reserved with no dealer.",
	"keywords": [ "galerio", "enquiry", "contact", "sale" ],
	"textdomain": "galerio-core",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"buttonText": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./index.js"
}
