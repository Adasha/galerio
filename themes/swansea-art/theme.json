{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "color": {
            "palette": [
                {
                    "color": "#ffffff",
                    "name": "Base",
                    "slug": "base"
                },
                {
                    "color": "#252525",
                    "name": "Contrast",
                    "slug": "contrast"
                },
                {
                    "color": "#cb3725",
                    "name": "Primary",
                    "slug": "primary"
                },
                {
                    "color": "#820101",
                    "name": "Secondary",
                    "slug": "secondary"
                },
                {
                    "color": "#767676",
                    "name": "Lower contrast",
                    "slug": "custom-lower-contrast"
                },
                {
                    "color": "#ececec",
                    "name": "Highlight",
                    "slug": "custom-highlight"
                },
                {
                    "color": "#f3f3f3",
                    "name": "Hint",
                    "slug": "custom-hint"
                },
                {
                    "color": "#5e5e5e",
                    "name": "Lowlight",
                    "slug": "custom-lowlight"
                }
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "name": "Heading",
                    "slug": "heading",
                    "fontFamily": "Montserrat, sans-serif",
                    "fontFace": [
                        {
                            "src": [ "file:./assets/fonts/montserrat/montserrat-latin-normal.woff2" ],
                            "fontWeight": "100 900",
                            "fontStyle": "normal",
                            "fontFamily": "Montserrat",
                            "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
                        },
                        {
                            "src": [ "file:./assets/fonts/montserrat/montserrat-latin-ext-normal.woff2" ],
                            "fontWeight": "100 900",
                            "fontStyle": "normal",
                            "fontFamily": "Montserrat",
                            "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
                        },
                        {
                            "src": [ "file:./assets/fonts/montserrat/montserrat-latin-italic.woff2" ],
                            "fontWeight": "100 900",
                            "fontStyle": "italic",
                            "fontFamily": "Montserrat",
                            "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
                        },
                        {
                            "src": [ "file:./assets/fonts/montserrat/montserrat-latin-ext-italic.woff2" ],
                            "fontWeight": "100 900",
                            "fontStyle": "italic",
                            "fontFamily": "Montserrat",
                            "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
                        }
                    ]
                },
                {
                    "name": "Body",
                    "slug": "body",
                    "fontFamily": "Lato, sans-serif",
                    "fontFace": [
                        {
                            "src": [ "file:./assets/fonts/lato/lato-400-normal.woff2" ],
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [ "file:./assets/fonts/lato/lato-400-italic.woff2" ],
                            "fontWeight": "400",
                            "fontStyle": "italic",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [ "file:./assets/fonts/lato/lato-700-normal.woff2" ],
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [ "file:./assets/fonts/lato/lato-700-italic.woff2" ],
                            "fontWeight": "700",
                            "fontStyle": "italic",
                            "fontFamily": "Lato"
                        }
                    ]
                }
            ]
        }
    },
    "styles": {
        "elements": {
            "heading": {
                "color": {
                    "text": "inherit"
                },
                "typography": {
                    "fontWeight": "700",
                    "letterSpacing": "-0.05em",
                    "textTransform": "inherit"
                }
            },
            "h1": {
                "typography": {
                    "textTransform": "inherit"
                }
            },
            "link": {
                ":hover": {
                    "color": {
                        "text": "#dd3333"
                    }
                }
            }
        },
        "blocks": {
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "letterSpacing": "-0.05em"
                }
            },
            "core/site-tagline": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "letterSpacing": "-0.05em"
                }
            }
        }
    }
}
