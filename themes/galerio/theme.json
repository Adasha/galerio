{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "palette": [
                {
                    "color": "#ffffff",
                    "name": "Base",
                    "slug": "base"
                },
                {
                    "color": "#303030",
                    "name": "Contrast",
                    "slug": "contrast"
                },
                {
                    "color": "#dc1616",
                    "name": "Primary",
                    "slug": "primary"
                },
                {
                    "color": "#bd1818",
                    "name": "Secondary",
                    "slug": "secondary"
                },
                {
                    "color": "#767676",
                    "name": "Lower contrast",
                    "slug": "custom-lower-contrast"
                },
                {
                    "color": "#e7e7e7",
                    "name": "Highlight",
                    "slug": "custom-highlight"
                },
                {
                    "color": "#f3f3f3",
                    "name": "Hint",
                    "slug": "custom-hint"
                },
                {
                    "color": "#686868",
                    "name": "Lowlight",
                    "slug": "custom-lowlight"
                }
            ]
        },
        "custom": {
            "button": {
                "border-radius": "5px"
            }
        },
        "layout": {
            "contentSize": "700px",
            "wideSize": "1100px"
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "slug": "10",
                    "name": "2X-Small",
                    "size": "0.375rem"
                },
                {
                    "slug": "20",
                    "name": "X-Small",
                    "size": "0.5rem"
                },
                {
                    "slug": "30",
                    "name": "Small",
                    "size": "0.75rem"
                },
                {
                    "slug": "40",
                    "name": "Medium",
                    "size": "1rem"
                },
                {
                    "slug": "50",
                    "name": "Large",
                    "size": "clamp(1.25rem, 1rem + 1vw, 1.5rem)"
                },
                {
                    "slug": "60",
                    "name": "X-Large",
                    "size": "clamp(1.5rem, 1rem + 2vw, 2.25rem)"
                },
                {
                    "slug": "70",
                    "name": "2X-Large",
                    "size": "clamp(2rem, 1.25rem + 3vw, 3.375rem)"
                },
                {
                    "slug": "80",
                    "name": "3X-Large",
                    "size": "clamp(2.5rem, 1.5rem + 4vw, 5rem)"
                }
            ],
            "units": [
                "px",
                "em",
                "rem",
                "vh",
                "vw",
                "%"
            ]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "name": "Heading",
                    "slug": "heading",
                    "fontFamily": "Arvo, serif",
                    "fontFace": [
                        {
                            "src": [
                                "file:./assets/fonts/arvo/arvo-400-normal.woff2"
                            ],
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontFamily": "Arvo"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/arvo/arvo-700-normal.woff2"
                            ],
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontFamily": "Arvo"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/arvo/arvo-400-italic.woff2"
                            ],
                            "fontWeight": "400",
                            "fontStyle": "italic",
                            "fontFamily": "Arvo"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/arvo/arvo-700-italic.woff2"
                            ],
                            "fontWeight": "700",
                            "fontStyle": "italic",
                            "fontFamily": "Arvo"
                        }
                    ]
                },
                {
                    "name": "Body",
                    "slug": "body",
                    "fontFamily": "Lato, sans-serif",
                    "fontFace": [
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-100-normal.woff2"
                            ],
                            "fontWeight": "100",
                            "fontStyle": "normal",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-300-normal.woff2"
                            ],
                            "fontWeight": "300",
                            "fontStyle": "normal",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-400-normal.woff2"
                            ],
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-700-normal.woff2"
                            ],
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-900-normal.woff2"
                            ],
                            "fontWeight": "900",
                            "fontStyle": "normal",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-100-italic.woff2"
                            ],
                            "fontWeight": "100",
                            "fontStyle": "italic",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-300-italic.woff2"
                            ],
                            "fontWeight": "300",
                            "fontStyle": "italic",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-400-italic.woff2"
                            ],
                            "fontWeight": "400",
                            "fontStyle": "italic",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-700-italic.woff2"
                            ],
                            "fontWeight": "700",
                            "fontStyle": "italic",
                            "fontFamily": "Lato"
                        },
                        {
                            "src": [
                                "file:./assets/fonts/lato/lato-900-italic.woff2"
                            ],
                            "fontWeight": "900",
                            "fontStyle": "italic",
                            "fontFamily": "Lato"
                        }
                    ]
                },
                {
                    "name": "Arvo",
                    "slug": "arvo",
                    "fontFamily": "Arvo, serif"
                },
                {
                    "name": "Lato",
                    "slug": "lato",
                    "fontFamily": "Lato, sans-serif"
                }
            ],
            "fontSizes": [
                {
                    "slug": "custom-1",
                    "name": "Very Small",
                    "size": "8px",
                    "fluid": false
                },
                {
                    "slug": "x-small",
                    "name": "Extra Small",
                    "size": "0.75rem",
                    "fluid": false
                },
                {
                    "slug": "small",
                    "name": "Small",
                    "size": "0.8125rem",
                    "fluid": false
                },
                {
                    "slug": "medium",
                    "name": "Medium",
                    "size": "1.125rem",
                    "fluid": false
                },
                {
                    "slug": "large",
                    "name": "Large",
                    "size": "2rem",
                    "fluid": {
                        "min": "1.75rem",
                        "max": "2rem"
                    }
                },
                {
                    "slug": "x-large",
                    "name": "Extra Large",
                    "size": "2.25rem",
                    "fluid": {
                        "min": "2rem",
                        "max": "2.25rem"
                    }
                },
                {
                    "slug": "xx-large",
                    "name": "Huge",
                    "size": "4rem",
                    "fluid": {
                        "min": "2.75rem",
                        "max": "4rem"
                    }
                }
            ]
        },
        "useRootPaddingAwareAlignments": true,
        "blocks": {
            "core/image": {
                "lightbox": {
                    "enabled": true,
                    "allowEditing": true
                }
            }
        }
    },
    "styles": {
        "blocks": {
            "core/button": {
                "color": {
                    "text": "var(--wp--preset--color--base)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--base)"
                        }
                    }
                }
            },
            "core/group": {
                "variations": {
                    "asides": {
                        "blocks": {
                            "core/group": {
                                "color": {
                                    "background": "var(--wp--preset--color--custom-hint)"
                                },
                                "css": "& div{margin-top: 0;}",
                                "spacing": {
                                    "blockGap": "var(--wp--preset--spacing--20)",
                                    "padding": {
                                        "bottom": "var(--wp--preset--spacing--20)",
                                        "left": "var(--wp--preset--spacing--40)",
                                        "right": "var(--wp--preset--spacing--40)",
                                        "top": "var(--wp--preset--spacing--20)"
                                    }
                                },
                                "typography": {
                                    "fontSize": "var(--wp--preset--font-size--medium)"
                                }
                            },
                            "galerio/field-display": {
                                "color": {
                                    "background": "var(--wp--preset--color--custom-hint)"
                                },
                                "css": "& .wp-block-galerio-field-display__label{margin:0 0 0.25em;} & ul{list-style:none;margin:0;padding:0;}",
                                "spacing": {
                                    "blockGap": "var(--wp--preset--spacing--20)",
                                    "padding": {
                                        "bottom": "var(--wp--preset--spacing--20)",
                                        "left": "var(--wp--preset--spacing--40)",
                                        "right": "var(--wp--preset--spacing--40)",
                                        "top": "var(--wp--preset--spacing--20)"
                                    }
                                },
                                "typography": {
                                    "fontSize": "var(--wp--preset--font-size--medium)"
                                }
                            }
                        }
                    },
                    "image-box": {
                        "color": {
                            "background": "var(--wp--preset--color--custom-hint)"
                        },
                        "spacing": {
                            "padding": {
                                "top": "var(--wp--preset--spacing--40)",
                                "right": "var(--wp--preset--spacing--40)",
                                "bottom": "var(--wp--preset--spacing--40)",
                                "left": "var(--wp--preset--spacing--40)"
                            }
                        },
                        "css": "display:flex;align-items:center;justify-content:center;min-height:67vh;& .wp-block-image{margin:0;}& .wp-block-image img{display:block;width:auto;max-height:calc(67vh - 2 * var(--wp--preset--spacing--40));object-fit:contain;}"
                    }
                }
            },
            "core/navigation": {
                "variations": {
                    "main-menu": {
                        "spacing": {
                            "blockGap": "var(--wp--preset--spacing--40)"
                        },
                        "typography": {
                            "lineHeight": "1.5"
                        }
                    }
                }
            },
            "core/post-terms": {
                "color": {
                    "text": "var(--wp--preset--color--contrast)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--custom-lower-contrast)"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--custom-lowlight)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "textDecoration": "none",
                    "textTransform": "uppercase"
                },
                "variations": {
                    "buttons": {
                        "elements": {
                            "link": {
                                ":hover": {
                                    "color": {
                                        "background": "var(--wp--preset--color--custom-hint)"
                                    }
                                },
                                "border": {
                                    "radius": "var(--wp--custom--button--border-radius)"
                                },
                                "color": {
                                    "background": "var(--wp--preset--color--custom-highlight)"
                                },
                                "css": "text-wrap: nowrap; display: inline-block; margin-block: 0.2em",
                                "spacing": {
                                    "padding": {
                                        "bottom": "var(--wp--preset--spacing--20)",
                                        "left": "var(--wp--preset--spacing--40)",
                                        "right": "var(--wp--preset--spacing--40)",
                                        "top": "var(--wp--preset--spacing--20)"
                                    }
                                },
                                "typography": {
                                    "textDecoration": "none"
                                }
                            }
                        },
                        "spacing": {
                            "blockGap": "var(--wp--preset--spacing--20)",
                            "margin": {
                                "bottom": "var(--wp--preset--spacing--20)",
                                "top": "var(--wp--preset--spacing--20)"
                            }
                        },
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--small)",
                            "lineHeight": "2.4"
                        }
                    }
                }
            },
            "core/search": {
                "css": "width: 100%",
                "elements": {
                    "button": {
                        "spacing": {
                            "padding": {
                                "bottom": "var(--wp--preset--spacing--20)",
                                "top": "var(--wp--preset--spacing--20)"
                            }
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "lineHeight": "1"
                }
            },
            "core/site-title": {
                "css": "overflow-wrap: anywhere; hyphens: auto;",
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontStyle": "normal",
                    "fontWeight": "700",
                    "lineHeight": "1",
                    "textTransform": "none"
                },
                "variations": {
                    "keep-words": {
                        "css": "overflow-wrap: normal; word-break: normal;"
                    },
                    "hyphenate": {
                        "css": "overflow-wrap: normal; hyphens: auto;"
                    }
                }
            },
            "core/social-links": {
                "border": {
                    "bottom": {
                        "style": "none",
                        "width": "0px"
                    },
                    "color": null,
                    "left": {
                        "style": "none",
                        "width": "0px"
                    },
                    "radius": "0px",
                    "right": {
                        "style": "none",
                        "width": "0px"
                    },
                    "style": null,
                    "top": {
                        "style": "none",
                        "width": "0px"
                    },
                    "width": null
                },
                "spacing": {
                    "blockGap": {
                        "left": "0"
                    }
                }
            },
            "galerio/field-display": {
                "variations": {
                    "buttons": {
                        "elements": {
                            "link": {
                                ":hover": {
                                    "color": {
                                        "background": "var(--wp--preset--color--custom-hint)",
                                        "text": "var(--wp--preset--color--custom-lower-contrast)"
                                    }
                                },
                                "border": {
                                    "radius": "var(--wp--custom--button--border-radius)"
                                },
                                "color": {
                                    "background": "var(--wp--preset--color--custom-highlight)",
                                    "text": "var(--wp--preset--color--custom-lowlight)"
                                },
                                "css": "text-wrap: nowrap; display: inline-block; margin-block: 0.2em",
                                "spacing": {
                                    "padding": {
                                        "bottom": "var(--wp--preset--spacing--20)",
                                        "left": "var(--wp--preset--spacing--40)",
                                        "right": "var(--wp--preset--spacing--40)",
                                        "top": "var(--wp--preset--spacing--20)"
                                    }
                                },
                                "typography": {
                                    "textDecoration": "none"
                                }
                            }
                        },
                        "spacing": {
                            "blockGap": "var(--wp--preset--spacing--20)",
                            "margin": {
                                "bottom": "var(--wp--preset--spacing--20)",
                                "top": "var(--wp--preset--spacing--20)"
                            }
                        },
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--small)",
                            "lineHeight": "2.4",
                            "textTransform": "uppercase"
                        },
                        "css": "& .wp-block-galerio-field-display__list{display:flex;flex-wrap:wrap;gap:var(--wp--preset--spacing--20);margin:0;padding:0;list-style:none;}& .wp-block-galerio-field-display__list li{margin:0;}& .wp-block-galerio-field-display__list a{display:inline-block;}"
                    }
                }
            }
        },
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "elements": {
            "button": {
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--custom-lower-contrast)"
                    }
                },
                "border": {
                    "radius": "var(--wp--custom--button--border-radius)"
                },
                "color": {
                    "background": "var(--wp--preset--color--custom-lowlight)",
                    "text": "var(--wp--preset--color--base)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontStyle": "normal",
                    "fontWeight": "700"
                }
            },
            "caption": {
                "color": {
                    "text": "var(--wp--preset--color--custom-lower-contrast)"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "textTransform": "uppercase"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--contrast)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontStyle": "normal",
                    "fontWeight": "400",
                    "textTransform": "none"
                }
            },
            "link": {
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--secondary)"
                    }
                },
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                }
            }
        },
        "spacing": {
            "padding": {
                "bottom": "0px",
                "left": "0px",
                "right": "0px",
                "top": "0px"
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "fontStyle": "normal",
            "fontWeight": "400",
            "lineHeight": "1.4",
            "textTransform": "none"
        },
        "css": "/* The side menu stays exactly where it is as the page scrolls: it sticks as far down as its column is padded, rather than at the very top after moving up by that much. */\n@media (min-width: 782px){.wp-block-column > header.wp-block-group.is-position-sticky{top:calc(var(--wp--preset--spacing--40) + var(--wp-admin--admin-bar--position-offset, 0px));}}\n/* Column style \"Stays in view\": the column stays in view as the page scrolls; a column taller than the window first scrolls to its end (assets/js/stays-in-view.js sets how far from the top it sticks). Off on phones, where columns stack. */\n@media (min-width: 782px){.wp-block-column.is-style-stays-in-view{position:sticky;top:var(--galerio-stays-in-view-top,calc(var(--wp-admin--admin-bar--height, 0px) + var(--wp--preset--spacing--40)));align-self:flex-start;}}\n/* A comma after an item, only when the next item has content (e.g. \"Welsh, b. 1978\"). */\n.galerio-comma-after:not(:empty):has(+ :not(:empty))::after{content:\",\";}\n/* On phones the image box fits its image instead of filling most of the screen. */\n@media (max-width: 781px){.wp-block-group.is-style-image-box{min-height:0;}}\n/* A details table: when its box is too narrow for a label beside its value, the label goes above. */\n.galerio-details{container-type:inline-size;}\n@container (max-width: 20rem){.galerio-details .wp-block-columns{flex-wrap:wrap !important;gap:0;}.galerio-details .wp-block-column{flex-basis:100% !important;}}\n/* On phones the side menu's header is a bar: site title on the left, menu button on the right. */\n@media (max-width: 781px){.wp-block-group.galerio-site-header{flex-direction:row;align-items:flex-start;justify-content:space-between;gap:var(--wp--preset--spacing--40);}}\n/* A see-through panel over an image, in the background colour, e.g. a collection's title over its cover. */\n.galerio-veil{background-color:color-mix(in srgb, var(--wp--preset--color--base) 67%, transparent);}\n/* WordPress gives every sticky block the same z-index, so an open menu inside one sticky block (the site header) could sit under a later one (e.g. the docs menu). Lift the block holding an open menu above the rest. */\n.is-position-sticky:has(.wp-block-navigation__responsive-container.is-menu-open){z-index:100000;}\n/* On phones the tagline is hidden, and the site title gives way to the menu button rather than overlapping it. */\n@media (max-width: 781px){.galerio-site-header .wp-block-site-tagline,.galerio-header-bar .wp-block-site-tagline{display:none;}.galerio-site-header > .wp-block-group:first-child,.galerio-header-bar > .wp-block-group:first-child{flex:1 1 0;min-width:0;}.galerio-site-header .wp-block-navigation,.galerio-header-bar .wp-block-navigation{flex:none;}}\n/* Titles of items in lists are links without an underline, which comes back on hover. */\n.wp-block-post-template :is(h1,h2,h3,h4,h5,h6) a,.wp-block-post-title a{text-decoration:none;}.wp-block-post-template :is(h1,h2,h3,h4,h5,h6) a:hover,.wp-block-post-title a:hover{text-decoration:underline;}\n/* Main Menu style: each item highlights on hover, and the current page stays highlighted. Here rather than in the style variation, whose rules WordPress gives no specificity, so the navigation block's own link styles would win. */\n.wp-block-navigation.is-style-main-menu .wp-block-navigation-item__content{display:block;padding:0.3em 0.5em;color:var(--wp--preset--color--contrast);text-transform:uppercase;transition:background-color 0.15s ease,color 0.15s ease;}.wp-block-navigation.is-style-main-menu .wp-block-navigation__submenu-container .wp-block-navigation-item__content{text-transform:lowercase;}.wp-block-navigation.is-style-main-menu.is-vertical :is(.wp-block-navigation__container,.wp-block-page-list){gap:0.15em;}.wp-block-navigation.is-style-main-menu.is-vertical .wp-block-navigation-item__content{margin-inline-start:-0.5em;}.wp-block-navigation.is-style-main-menu .wp-block-navigation-item__content:hover,.wp-block-navigation.is-style-main-menu .wp-block-navigation-item__content:focus-visible,.wp-block-navigation.is-style-main-menu .wp-block-navigation-item__content[aria-current=\"page\"]{background-color:var(--wp--preset--color--contrast);color:var(--wp--preset--color--base);}.wp-block-navigation.is-style-main-menu .wp-block-navigation__submenu-container .wp-block-navigation-item__content:hover,.wp-block-navigation.is-style-main-menu .wp-block-navigation__submenu-container .wp-block-navigation-item__content:focus-visible,.wp-block-navigation.is-style-main-menu .wp-block-navigation__submenu-container .wp-block-navigation-item__content[aria-current=\"page\"]{background-color:var(--wp--preset--color--custom-highlight);color:var(--wp--preset--color--contrast);}\n@media (prefers-reduced-motion: reduce){.wp-block-navigation.is-style-main-menu .wp-block-navigation-item__content{transition:none;}}\n/* A cover that shows its item's featured image but finds none is a plain colour band; a child theme can change the colour with --galerio-cover-no-image. */\n.wp-block-cover.galerio-cover-no-image{background-color:var(--galerio-cover-no-image,var(--wp--preset--color--custom-highlight));}\n/* Collection card: a slide like the carousel's, with the caption box no wider than a slide's. Its height comes from --galerio-collection-card-height, so a child theme can change it in one place only (e.g. .post-type-archive-galerio_collection .galerio-collection-card { --galerio-collection-card-height: 90vh; }). */\n.galerio-collection-card{min-height:var(--galerio-collection-card-height,420px);}.galerio-collection-card .galerio-collection-card__caption{max-width:min(32rem,100%);}.galerio-collection-card__caption .wp-block-post-title a{color:inherit;}.galerio-collection-card .galerio-collection-card__caption .wp-block-read-more{margin-top:var(--wp--preset--spacing--20);}\n/* Cards: side-by-side columns in a card stack when the card is narrow, e.g. a work card in a grid of small tiles. */\n.galerio-card{container-type:inline-size;}\n@container (max-width: 20rem){.galerio-card .wp-block-columns{flex-wrap:wrap !important;}.galerio-card .wp-block-column{flex-basis:100% !important;}}\n/* A narrow work card matches the other cards in a grid, e.g. on a medium's page: a square image, a title the size of a profile's name and a smaller creator line. */\n@container (max-width: 20rem){.galerio-card-work .wp-block-post-featured-image img{aspect-ratio:1;object-fit:cover;}.galerio-card-work .wp-block-heading{font-size:var(--wp--preset--font-size--medium);}.galerio-card-work h3.wp-block-heading{font-family:var(--wp--preset--font-family--body);font-size:var(--wp--preset--font-size--small);text-transform:uppercase;}}\n/* A card leaves out lines with nothing in them, such as a work's year or a creator left out on that creator's own page. */\n.galerio-card :is(h1,h2,h3,h4,h5,h6,p):empty{display:none;}\n/* Lists in a details table, such as the collections a work is featured in, line up with their label: no bullets, indent or outer margins, one item per line. */\n.galerio-details .wp-block-galerio-field-display__list{list-style:none;margin:0;padding:0;}.galerio-details .wp-block-galerio-field-display__list li{margin:0;}.galerio-details .wp-block-galerio-field-display{margin:0;}\n/* A details table hides rows whose value is empty. */\n.galerio-details .wp-block-columns:has(> .wp-block-column:last-child:empty),.galerio-details .wp-block-columns:has(> .wp-block-column:last-child > p:only-child:empty){display:none;}\n/* When the first row is hidden, the next row loses its dividing line, which would otherwise top the table. */\n.galerio-details > .wp-block-columns:first-child:is(:has(> .wp-block-column:last-child:empty),:has(> .wp-block-column:last-child > p:only-child:empty)) + .wp-block-columns{border-top-style:none !important;}\n/* Page numbers under a list: spaced, the current page filled in, the others highlighted on hover. */\n.wp-block-query-pagination{align-items:center;column-gap:var(--wp--preset--spacing--30);}.wp-block-query-pagination-numbers{display:flex;flex-wrap:wrap;gap:0.25em;}.wp-block-query-pagination-numbers .page-numbers{display:inline-block;min-width:1.5em;padding:0.2em 0.45em;text-align:center;text-decoration:none;font-size:var(--wp--preset--font-size--small);}.wp-block-query-pagination-numbers .page-numbers.current{background-color:var(--wp--preset--color--contrast);color:var(--wp--preset--color--base);}.wp-block-query-pagination-numbers a.page-numbers:hover,.wp-block-query-pagination-numbers a.page-numbers:focus-visible{background-color:var(--wp--preset--color--custom-highlight);color:var(--wp--preset--color--contrast);}\n/* Form fields in Galerio's forms (archive filters, enquiries) match the buttons: the body font, small text, the button's corners, a dark border on a light field, a drawn arrow on dropdowns, and a clear focus ring. */\n:is(.wp-block-galerio-archive-filters,.wp-block-galerio-enquiry) :is(select,input:not([type=hidden]),textarea){box-sizing:border-box;font-family:var(--wp--preset--font-family--body);font-size:var(--wp--preset--font-size--small);line-height:1.4;color:var(--wp--preset--color--contrast);background-color:var(--wp--preset--color--base);border:1px solid var(--wp--preset--color--custom-lowlight);border-radius:var(--wp--custom--button--border-radius);padding:0.55em 0.75em;}:is(.wp-block-galerio-archive-filters,.wp-block-galerio-enquiry) :is(select,input:not([type=hidden]),textarea):hover{border-color:var(--wp--preset--color--contrast);}:is(.wp-block-galerio-archive-filters,.wp-block-galerio-enquiry) :is(select,input:not([type=hidden]),textarea,summary,button):focus-visible{outline:2px solid var(--wp--preset--color--contrast);outline-offset:2px;}:is(.wp-block-galerio-archive-filters,.wp-block-galerio-enquiry) select{appearance:none;min-width:11em;padding-right:2.25em;cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);background-position:calc(100% - 1.15em) 52%,calc(100% - 0.8em) 52%;background-size:0.35em 0.35em;background-repeat:no-repeat;}:is(.wp-block-galerio-archive-filters,.wp-block-galerio-enquiry) label{font-size:var(--wp--preset--font-size--small);font-weight:700;}\n/* The archive filters' heading reads like the page links: small capitals. */\n.wp-block-galerio-archive-filters__summary{font-size:var(--wp--preset--font-size--small);font-weight:700;text-transform:uppercase;letter-spacing:0.05em;}.wp-block-galerio-archive-filters__count{font-weight:400;text-transform:none;letter-spacing:0;}.wp-block-galerio-archive-filters__clear{font-size:var(--wp--preset--font-size--small);}"
    },
