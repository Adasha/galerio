#: patterns/collection-card.php
msgctxt "Pattern title"
msgid "Collection card"
msgstr ""

#: patterns/collection-card.php
msgctxt "Pattern description"
msgid "A collection as a slide like the front page carousel's: its image filling the card, with a caption box holding the title, dates, categories and a button. Use it inside a Query Loop of collections, or in a Galerio Carousel's Query Loop. Its height is 420px unless --galerio-collection-card-height says otherwise, so a child theme can make the cards taller in one place, such as the collections archive."
msgstr ""

#. translators: Button on a collection card. {collection} is the site's name for a collection, such as "exhibition".
#: patterns/collection-card.php:21
msgid "View {collection}"
msgstr ""

