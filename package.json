{
	"name": "galerio",
	"version": "0.2.0-alpha",
	"private": true,
	"description": "WordPress theme and plugins for galleries, artists and publishers to manage, present and sell creative works.",
	"license": "GPL-2.0-or-later",
	"author": "Adam Shailer",
	"homepage": "https://github.com/Adasha/galerio#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Adasha/galerio.git"
	},
	"bugs": {
		"url": "https://github.com/Adasha/galerio/issues"
	},
	"keywords": [
		"wordpress",
		"block-theme",
		"gallery",
		"art",
		"artist",
		"exhibition",
		"collection",
		"portfolio"
	],
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:reset": "wp-env reset && npm run seed",
		"env:test:start": "wp-env --config=.wp-env.test.json start",
		"env:test:stop": "wp-env --config=.wp-env.test.json stop",
		"env:trial:start": "wp-env --config=.wp-env.trial.json start",
		"env:trial:stop": "wp-env --config=.wp-env.trial.json stop",
		"trial:import": "bash tools/trial-import.sh",
		"env:swansea:start": "wp-env --config=.wp-env.swansea.json start",
		"env:swansea:stop": "wp-env --config=.wp-env.swansea.json stop",
		"swansea:load": "bash tools/local-copy.sh .wp-env.swansea.json",
		"seed": "bash tools/seed-demo.sh",
		"seed:test": "bash tools/seed-demo.sh --test",
		"wp": "wp-env run cli wp",
		"build": "npm run build:blocks && npm run build:media && npm run build:core",
		"build:blocks": "wp-scripts build --webpack-src-dir=plugins/galerio-blocks/src --output-path=plugins/galerio-blocks/build",
		"build:media": "wp-scripts build folders=./plugins/galerio-media/src/folders.js --output-path=plugins/galerio-media/build",
		"build:core": "wp-scripts build field-editor=./plugins/galerio-core/src/field-editor/index.js --output-path=plugins/galerio-core/build",
		"start": "wp-scripts start --webpack-src-dir=plugins/galerio-blocks/src --output-path=plugins/galerio-blocks/build",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php",
		"lint:js": "wp-scripts lint-js \"plugins/galerio-*/src\" \"plugins/galerio-*/assets/js\" \"plugins/galerio-*/blocks\" \"tests/e2e\" --no-error-on-unmatched-pattern",
		"lint:css": "wp-scripts lint-style \"plugins/galerio-*/src/**/*.{css,scss}\" --allow-empty-input",
		"lint:php": "bash tools/composer.sh lint",
		"lint:php:fix": "bash tools/composer.sh lint:fix",
		"composer": "bash tools/composer.sh",
		"format": "wp-scripts format",
		"i18n:pot": "wp-env run cli --env-cwd=wp-content/themes/galerio wp i18n make-pot . languages/galerio.pot --slug=galerio --exclude=assets && wp-env run cli --env-cwd=wp-content/plugins/galerio-core wp i18n make-pot . languages/galerio-core.pot --slug=galerio-core && wp-env run cli --env-cwd=wp-content/plugins/galerio-blocks wp i18n make-pot . languages/galerio-blocks.pot --slug=galerio-blocks --exclude=src,node_modules && wp-env run cli --env-cwd=wp-content/plugins/galerio-media wp i18n make-pot . languages/galerio-media.pot --slug=galerio-media",
		"package": "bash tools/package.sh",
		"docs:fields": "bash tools/update-field-reference.sh",
		"test:php": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/galerio-repo vendor/bin/phpunit",
		"check:plugins": "wp-env --config=.wp-env.test.json run cli wp plugin check galerio-core && wp-env --config=.wp-env.test.json run cli wp plugin check galerio-blocks && wp-env --config=.wp-env.test.json run cli wp plugin check galerio-media",
		"test:e2e": "playwright test --config tests/e2e/playwright.config.js"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/scripts": "^37.0.0"
	},
	"dependencies": {
		"embla-carousel": "^8.6.0",
		"embla-carousel-fade": "^8.6.0"
	}
}
