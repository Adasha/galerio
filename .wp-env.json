{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"port": 8888,
	"testsEnvironment": false,
	"plugins": [
		"https://downloads.wordpress.org/plugin/pods.zip",
		"./plugins/galerio-core",
		"./plugins/galerio-blocks",
		"./plugins/galerio-media"
	],
	"themes": [ "./themes/galerio", "./themes/galerio-child-starter" ],
	"mappings": {
		"wp-content/galerio-data": "./data",
		"wp-content/galerio-tools": "./tools",
		"wp-content/mu-plugins": "./tools/mu-plugins"
	},
	"config": {
		"WP_DEBUG_LOG": true,
		"WP_DEVELOPMENT_MODE": "all",
		"WP_ENVIRONMENT_TYPE": "local"
	}
}
