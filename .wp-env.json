{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"port": 8888,
	"testsEnvironment": false,
	"plugins": [
		"https://downloads.wordpress.org/plugin/pods.zip",
		"./plugins/galerio-core"
	],
	"themes": [ "./themes/galerio" ],
	"mappings": {
		"wp-content/galerio-data": "./data",
		"wp-content/galerio-tools": "./tools"
	},
	"config": {
		"WP_DEBUG_LOG": true,
		"WP_ENVIRONMENT_TYPE": "local"
	}
}
